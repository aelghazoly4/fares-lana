# ---- مطلوبة ----
# رابط الاتصال بقاعدة MongoDB Atlas (Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# كلمة سر لوحة التحكم (/admin) - اختر كلمة قوية
ADMIN_PASSWORD=change-me-to-a-strong-password

# ---- اختيارية ----
# اسم قاعدة البيانات (الافتراضي: wedding_invitations)
MONGODB_DB=wedding_invitations
# معرّف الحفل: لو استخدمت نفس الكلستر لأكثر من دعوة، غيّره لكل دعوة
EVENT_ID=c
# العنوان الظاهر في لوحة التحكم
EVENT_TITLE=فارس & لانا
